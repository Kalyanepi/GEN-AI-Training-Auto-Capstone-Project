# =============================================================================
# RoadGuard AI Copilot — Environment Configuration
# Copy this file to .env and fill in real values. NEVER commit .env.
# =============================================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-replace-me
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ROUTER_MODEL=gpt-4o-mini
OPENAI_SYNTHESIS_MODEL=gpt-4o
OPENAI_GUARDRAIL_MODEL=gpt-4o-mini

# --- LangSmith (Observability) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_replace-me
LANGCHAIN_PROJECT=roadguard-copilot-dev
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- Paths (inside container or local) ---
DATA_DIR=./data
PDF_DIR=./data/pdfs
FAISS_INDEX_DIR=./data/faiss_index
REPAIR_COST_CSV=./data/RepairCost_ReferenceTable.csv
TOTAL_LOSS_CSV=./data/TotalLoss_Threshold_Table.csv

# --- RAG ---
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
EMBEDDING_BATCH_SIZE=100
RETRIEVAL_TOP_K=5
RETRIEVAL_OVERFETCH_MULTIPLIER=4
SIMILARITY_THRESHOLD=0.35
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Agent / Memory ---
CONVERSATION_WINDOW_K=10
SESSION_TTL_MINUTES=30
MAX_CITATIONS_PER_RESPONSE=4
CITATION_EXCERPT_MAX_CHARS=150

# --- Guardrails ---
FUZZY_DAMAGE_MATCH_THRESHOLD=0.60
FABRICATED_COST_TOLERANCE_PCT=10
ADJUSTER_PHONE=1-800-555-0601
ADJUSTER_URL=roadguardauto.com/claims

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
RATE_LIMIT_PER_MINUTE=30
REQUEST_TIMEOUT_SECONDS=30

# --- UI ---
UI_HOST=0.0.0.0
UI_PORT=8501

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
